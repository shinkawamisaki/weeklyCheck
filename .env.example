# (必須) 実行するシェルスクリプトの Raw URL。
# 必ずコミット SHA かタグで固定してください（ブランチ名は不可: 実行内容が黙って変わります）。
SCRIPT_SOURCE_URL="https://raw.githubusercontent.com/shinkawamisaki/checkRisk/27c9a9c4f582beba432948435d5747c997346d57/checkRisk.sh"

# (推奨) 上記スクリプトの SHA-256。設定すると CodeBuild がダウンロード後に照合し、不一致なら実行しません。
# 計算例: curl -fsSL "$SCRIPT_SOURCE_URL" | shasum -a 256
SCRIPT_SHA256="61fe39e3f2fd5d8f1a986f4408cdda3f2ad30b2adf21f696178b24cf1375e205"

# (任意) OpenAI による整形を有効化（"1" または "true"）。既定は無効。
POLISH_WITH_OPENAI="0"

# (任意) Secrets Manager のシークレット名（既定値から変えた場合のみ）
# SLACK_SECRET_NAME="slack/bot"
# OPENAI_SECRET_NAME="openai/prod/key"

# (任意) 私有リポジトリからスクリプトを取得する場合のみ設定。未設定なら PAT は取得しません。
# GITHUB_PAT_SECRET_NAME="github/pat"

# (任意) レポート保管バケットの設定
# REPORT_RETENTION_DAYS="365"   # レポートの保持日数（既定 365）
# RETAIN_BUCKET="1"             # cdk destroy でバケットを残す（既定は削除）
